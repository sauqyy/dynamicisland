{
  "name": "dynamic-island",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "sideEffects": ["**/*.css"],
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:ui": "tsc -b && vite build --mode ui",
    "dev:ui": "vite --mode ui",
    "tauri:ui": "tauri dev --config src-tauri/tauri.ui.conf.json -- --features campus",
    "tauri:build:ui": "tauri build --bundles nsis --config src-tauri/tauri.ui.conf.json -- --features campus",
    "lint": "oxlint",
    "preview": "vite preview",
    "tauri": "tauri"
  },
  "dependencies": {
    "@crabnebula/tauri-plugin-drag": "^2.1.0",
    "@fontsource-variable/geist": "^5.2.8",
    "@fontsource-variable/geist-mono": "^5.2.8",
    "@supabase/supabase-js": "^2.118.0",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-autostart": "^2.7.0",
    "@tauri-apps/plugin-clipboard-manager": "^2.5.0",
    "cuelume": "^0.2.8",
    "lucide-react": "^1.52.0",
    "motion": "^14.6.0",
    "pdfjs-dist": "^4.10.38",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.4",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.88.0",
    "typescript": "~6.0.3",
    "vite": "^8.3.4"
  }
}
