{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Dynamic Island Setup",
  "version": "0.3.8",
  "identifier": "com.dynamicisland.setup",
  "build": {
    "frontendDist": "./ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Dynamic Island Setup",
        "width": 600,
        "height": 380,
        "center": true,
        "resizable": false,
        "maximizable": false,
        "decorations": false,
        "transparent": true,
        "shadow": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
