{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Astra Isle",
  "version": "0.8.5",
  "identifier": "com.dynamicisland.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Astra Isle",
        "width": 520,
        "height": 340,
        "x": 0,
        "y": 0,
        "resizable": false,
        "fullscreen": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": false,
        "focus": false,
        "visible": true,
        "maximizable": false,
        "minimizable": false,
        "closable": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self' 'wasm-unsafe-eval'",
        "worker-src": "'self' blob:",
        "style-src": "'self' 'unsafe-inline'",
        "font-src": "'self' data:",
        "img-src": "'self' data: blob: https: asset: http://asset.localhost",
        "media-src": "'self' data: blob: asset: http://asset.localhost",
        "connect-src": "'self' ipc: http://ipc.localhost data: blob: https://*.supabase.co wss://*.supabase.co https://api.github.com https://lrclib.net https://api.open-meteo.com https://geocoding-api.open-meteo.com https://nominatim.openstreetmap.org https://ipwho.is https://ipinfo.io https://ipapi.co https://get.geojs.io https://freeipapi.com https://api.bigdatacloud.net https://huggingface.co https://*.huggingface.co https://*.hf.co",
        "object-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'",
        "frame-src": "'none'"
      },
      "devCsp": null,
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "sidebarImage": "installer/sidebar.bmp",
        "headerImage": "installer/header.bmp",
        "installerHooks": "installer/hooks.nsh"
      }
    },
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "publisher": "Astra Isle"
  }
}